---
import PageLayout from '@layouts/Page.astro';
import { fairUse } from '@/data/about';
import { checkIds } from '@/data/checks';

const elsewhere = [
  { title: `All ${checkIds.length} checks, explained`, link: '/checks' },
  { title: 'Run your own instance', link: '/self-hosted-setup' },
  { title: 'Use the API', link: '/web-check-api' },
];
---

<PageLayout
  title="About | Sentinel"
  description="About Sentinel website security and infrastructure intelligence."
  keywords="sentinel, website intelligence, security posture, infrastructure, privacy"
  breadcrumbs={[
    { name: 'Sentinel', item: '' },
    { name: 'About', item: 'about' },
  ]}
>
  <section class="intro">
    <h1>About Sentinel</h1>
    <p>
      Sentinel brings a website's public security posture, infrastructure, technology and domain
      signals into one focused intelligence report.
    </p>
    <h2>Designed for repeatable investigation</h2>
    <p>
      Run focused checks or a complete scan, inspect technical values as they arrive, and save a
      browser-local baseline to see what changed on a later visit. No account or database is
      required.
    </p>
    <ul class="elsewhere">
      {
        elsewhere.map((link) => (
          <li>
            <a href={link.link}>{link.title}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Fair use</h2>
    <ul>
      {fairUse.map((rule) => <li>{rule}</li>)}
    </ul>
  </section>

  <section>
    <h2>Privacy</h2>
    <p>
      Scan baselines and comparison data remain in this browser's local storage. Sentinel requires
      no account and sends no baseline history to a separate database.
    </p>
  </section>
</PageLayout>

<style lang="scss">
  section {
    margin-bottom: 4rem;

    h1 {
      margin: 0 0 1.5rem;
      font-size: clamp(2.25rem, 6vw, 3.5rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    h2 {
      font-size: 1.6rem;
      margin-bottom: 1rem;
    }

    p,
    li {
      max-width: 68ch;
      line-height: 1.7;
      color: var(--text-color-secondary);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  .elsewhere {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;

    a {
      display: block;
      padding: 0.5rem 1rem;
      border: 1px solid var(--background-lighter);
      border-radius: 3px;
      color: var(--text-color);
      font-weight: 600;
      transition:
        border-color 0.25s ease,
        color 0.25s ease;

      &:hover,
      &:focus-visible {
        border-color: var(--primary);
        color: var(--primary);
        text-decoration: none;
      }
    }
  }

  pre {
    margin-top: 1.5rem;
    padding: 1rem;
    background: var(--background-raised);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-color-thirdly);
    overflow-x: auto;
    max-width: fit-content;
  }
</style>
