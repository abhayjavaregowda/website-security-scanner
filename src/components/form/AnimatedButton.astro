---
interface Props {
  label?: string;
}

const { label = 'Analyze URL' } = Astro.props;
---

<div class="button">
  <button type="submit">{label}</button>
  <slot />
</div>

<style lang="scss">
  .button {
    display: flex;
    min-height: 4rem;
    font-size: 1rem;
    color: var(--background);
    border: 1px solid var(--primary);
    border-radius: 0.82rem;
    font-weight: 750;
    background: linear-gradient(
      120deg,
      var(--primary),
      color-mix(in srgb, var(--primary) 72%, white)
    );
    box-shadow: 0 12px 35px color-mix(in srgb, var(--primary) 14%, transparent);
    background-size: 180% 180%;
    animation: buttonGlow 5s ease-in-out infinite;
    transition:
      transform 0.2s ease-in-out,
      box-shadow 0.2s ease-in-out;
    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 42px color-mix(in srgb, var(--primary) 22%, transparent);
    }

    :global(button) {
      flex: 1;
      padding: 1rem 1.35rem;
      border: none;
      background: none;
      color: inherit;
      cursor: pointer;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      animation: none;
    }
  }

  @keyframes buttonGlow {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
</style>
