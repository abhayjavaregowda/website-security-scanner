<nav class="navbar">
  <div class="nav-left">
    <a href="/" class="logo-link" aria-label="Home">
      <img width="64" src="/favicon.svg" alt="" />
      <h2 class="site-title">
        <span class="first">Sentinel</span>
        <span class="edition">INTELLIGENCE</span>
      </h2>
    </a>
    <slot name="tool" />
  </div>
  <div class="nav-right">
    <slot>
      <a href="/check" class="nav-link">Scan</a>
      <a href="/checks" class="nav-link">Checks</a>
      <a href="/web-check-api" class="nav-link">API</a>
    </slot>
  </div>
</nav>

<style lang="scss">
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0.8rem 0.65rem 1rem;
    flex-wrap: wrap;
    background: color-mix(in srgb, var(--background-raised) 76%, transparent);
    color: var(--text-color);
    width: var(--page-width);
    margin: 0 auto;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--primary) 16%, transparent);
    box-shadow: 0 12px 50px rgba(0, 0, 0, 0.26);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    .nav-left {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 1rem;

      .logo-link {
        display: flex;
        align-items: center;
        text-decoration: none;
        color: var(--text-color);

        img {
          width: 2.15rem;
          max-width: 64px;
          margin-right: 0.5rem;
        }

        .site-title {
          margin: 0;
          display: flex;
          flex-direction: column;
          font-weight: 750;
          color: var(--primary);
          font-size: 1.16rem;
          line-height: 1;
          letter-spacing: -0.02em;
          .first {
            color: var(--primary);
          }
          .edition {
            margin-top: 0.22rem;
            color: var(--text-color-thirdly);
            font-size: 0.5rem;
            font-weight: 700;
            letter-spacing: 0.16em;
          }
        }
      }
    }

    .nav-right {
      display: flex;

      .nav-link {
        text-decoration: none;
        color: var(--text-color);
        margin-left: 0.25rem;
        padding: 0.55rem 0.75rem;
        border-radius: 0.6rem;
        font-size: 0.9rem;
        transition: background-color 0.3s;
        position: relative;
        &:hover {
          background-color: var(--primary-transparent);
          text-decoration: none;
        }
        &:focus {
          outline: none;
          background-color: var(--primary-dark);
          box-shadow: 0 0 0 3px var(--primary);
        }
        &:after {
          background: none repeat scroll 0 0 transparent;
          bottom: 0;
          content: '';
          display: block;
          height: 2px;
          left: 50%;
          position: absolute;
          background: var(--primary);
          transition:
            width 0.3s ease 0s,
            left 0.3s ease 0s;
          width: 0;
        }
        &:hover:after {
          width: 100%;
          left: 0;
        }

        &.upstream {
          border: 1px solid var(--primary-transparent);
        }
      }
    }
  }

  @media (max-width: 600px) {
    .navbar {
      .nav-right .nav-link {
        padding-inline: 0.5rem;
        font-size: 0.78rem;
      }
      .nav-right .upstream {
        display: none;
      }
    }
  }
</style>
